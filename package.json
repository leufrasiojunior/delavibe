{
  "name": "delavibe-pdv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "images:build": "docker compose build app",
    "images:export": "docker save -o delavibe-images.tar delavibe/app:local",
    "images:import": "docker load -i delavibe-images.tar",
    "init": "docker compose up -d db app && docker compose exec app npm run db:seed",
    "init:build": "docker compose up -d --build db app && docker compose exec app npm run db:seed",
    "up": "docker compose up -d db app",
    "up:build": "docker compose up -d --build db app",
    "up:logs": "docker compose up db app",
    "down": "docker compose down",
    "down:volumes": "docker compose down -v",
    "seed:manual": "docker compose exec app npm run db:seed",
    "logs:app": "docker compose logs app --tail=200",
    "db:backup": "docker compose exec db pg_dump -U ${POSTGRES_USER:-delavibe} ${POSTGRES_DB:-delavibe} > backups/delavibe-$(date +%Y%m%d-%H%M%S).sql",
    "typecheck": "tsc --noEmit",
    "test": "RATE_LIMIT_DRIVER=memory node --import tsx --test tests/**/*.test.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "bcryptjs": "3.0.2",
    "dotenv": "^16.6.1",
    "lucide-react": "^1.16.0",
    "next": "^16.2.3",
    "pg": "^8.20.0",
    "prisma": "^7.7.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^3.8.1",
    "tsx": "4.19.3",
    "web-push": "^3.6.7",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.14.0",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@types/web-push": "^3.6.4",
    "typescript": "5.8.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
