generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  operator
}

enum CommandaStatus {
  open
  closed
  cancelled
}

enum PaymentMethod {
  cash
  pix
  debit
  credit
}

enum StockMovementReason {
  manual_entry
  manual_adjustment
  comanda_item_add
  comanda_item_remove
  comanda_cancel_reversal
  web_order_create
  web_order_cancel_reversal
}

enum WebOrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum WebOrderStatusActorType {
  admin
  system
}

enum DeliveryMode {
  PICKUP
  DELIVERY
}

model User {
  id                 String              @id @default(cuid())
  name               String
  username           String              @unique
  passwordHash       String
  role               Role                @default(operator)
  isActive           Boolean             @default(true)
  sessions           Session[]
  commandas          Commanda[]
  payments           Payment[]
  stockMoves         StockMovement[]
  auditLogs          AuditLog[]
  webOrderStatusLogs WebOrderStatusLog[]
  pushSubscriptions  PushSubscription[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  csrfToken String
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id            String          @id @default(cuid())
  name          String
  sku           String?         @unique
  barcode       String          @unique
  category      String?
  imagePath     String?
  unit          String          @default("un")
  priceCents    Int
  costCents     Int?
  stockQty      Int             @default(0)
  minimumStock  Int             @default(0)
  isActive      Boolean         @default(true)
  items         ComandaItem[]
  stockMoves    StockMovement[]
  webOrderItems WebOrderItem[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([name])
  @@index([category])
}

model Commanda {
  id            String         @id @default(cuid())
  number        Int            @unique @default(autoincrement())
  status        CommandaStatus @default(open)
  customerName  String?
  notes         String?
  subtotalCents Int            @default(0)
  discountCents Int            @default(0)
  totalCents    Int            @default(0)
  operatorId    String
  operator      User           @relation(fields: [operatorId], references: [id])
  items         ComandaItem[]
  payments      Payment[]
  closedAt      DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([operatorId])
}

model ComandaItem {
  id             String   @id @default(cuid())
  comandaId      String
  productId      String
  quantity       Int
  unitPriceCents Int
  subtotalCents  Int
  comanda        Commanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([comandaId, createdAt])
  @@index([productId])
}

model Payment {
  id          String        @id @default(cuid())
  comandaId   String
  operatorId  String
  method      PaymentMethod
  amountCents Int
  notes       String?
  comanda     Commanda      @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  operator    User          @relation(fields: [operatorId], references: [id])
  createdAt   DateTime      @default(now())

  @@index([comandaId, createdAt])
  @@index([operatorId])
  @@index([method])
}

model StockMovement {
  id             String              @id @default(cuid())
  productId      String
  actorUserId    String?
  quantityDelta  Int
  resultingStock Int
  reason         StockMovementReason
  notes          String?
  referenceType  String?
  referenceId    String?
  product        Product             @relation(fields: [productId], references: [id])
  actor          User?               @relation(fields: [actorUserId], references: [id])
  createdAt      DateTime            @default(now())

  @@index([productId, createdAt])
  @@index([actorUserId])
  @@index([reason])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  limit     Int
  windowMs  Int
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model Customer {
  id                      String            @id @default(cuid())
  email                   String            @unique
  name                    String
  phone                   String
  passwordHash            String?
  isGuest                 Boolean           @default(false)
  consentDataProcessingAt DateTime
  consentMarketingAt      DateTime?
  consentPolicyVersion    String
  consentIpAddress        String?
  deletedAt               DateTime?
  addresses               CustomerAddress[]
  sessions                CustomerSession[]
  webOrders               WebOrder[]
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([deletedAt])
  @@index([isGuest])
}

model CustomerAddress {
  id           String     @id @default(cuid())
  customerId   String
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zip          String
  reference    String?
  isDefault    Boolean    @default(false)
  isActive     Boolean    @default(true)
  webOrders    WebOrder[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([customerId])
  @@index([customerId, isDefault])
}

model CustomerSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  csrfToken  String
  expiresAt  DateTime
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([expiresAt])
}

model WebOrder {
  id                  String              @id @default(cuid())
  customerId          String
  customer            Customer            @relation(fields: [customerId], references: [id])
  status              WebOrderStatus      @default(PENDING_PAYMENT)
  deliveryMode        DeliveryMode
  totalCents          Int
  notes               String?
  addressId           String?
  address             CustomerAddress?    @relation(fields: [addressId], references: [id])
  addressStreet       String?
  addressNumber       String?
  addressComplement   String?
  addressNeighborhood String?
  addressCity         String?
  addressState        String?
  addressZip          String?
  addressReference    String?
  items               WebOrderItem[]
  statusLogs          WebOrderStatusLog[]
  paidMethods         PaymentMethod[]     @default([])
  statusUpdatedAt     DateTime            @default(now())
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([customerId, createdAt])
}

model WebOrderItem {
  id             String   @id @default(cuid())
  webOrderId     String
  webOrder       WebOrder @relation(fields: [webOrderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  productName    String
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int
  createdAt      DateTime @default(now())

  @@index([webOrderId, createdAt])
  @@index([productId])
}

model WebOrderStatusLog {
  id          String                  @id @default(cuid())
  webOrderId  String
  webOrder    WebOrder                @relation(fields: [webOrderId], references: [id], onDelete: Cascade)
  fromStatus  WebOrderStatus?
  toStatus    WebOrderStatus
  actorUserId String?
  actor       User?                   @relation(fields: [actorUserId], references: [id])
  actorType   WebOrderStatusActorType
  notes       String?
  createdAt   DateTime                @default(now())

  @@index([webOrderId, createdAt])
}
