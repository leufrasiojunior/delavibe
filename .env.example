POSTGRES_USER="delavibe"
POSTGRES_DB="delavibe"
POSTGRES_PASSWORD="change-me-local-only"
DATABASE_URL="postgresql://delavibe:change-me-local-only@localhost:5433/delavibe?schema=public"
NODE_ENV="development"
SESSION_COOKIE_NAME="pdv_session"
SESSION_COOKIE_SECURE="false"
CSRF_COOKIE_NAME="pdv_csrf"
NEXT_PUBLIC_CSRF_COOKIE_NAME="pdv_csrf"
SESSION_TTL_HOURS="12"
APP_TIMEZONE="America/Sao_Paulo"
NEXT_PUBLIC_APP_NAME="Dela's Vibe PDV"
TZ="America/Sao_Paulo"
# Sessão do cliente final (separada da sessão admin/operator).
CUSTOMER_SESSION_TTL_HOURS="168"
CUSTOMER_SESSION_COOKIE_NAME="customer_session"
CUSTOMER_CSRF_COOKIE_NAME="customer_csrf"
# TTL automatico de pedidos web em PENDING_PAYMENT (minutos) antes do cancelamento.
WEB_ORDER_PENDING_TTL_MINUTES="60"
# Diretório onde imagens de produto são armazenadas.
# Em Docker, deve apontar para um volume persistente (ver docker-compose).
# Em dev local sem Docker, garanta que o diretório exista e seja writeable.
UPLOADS_DIR="/app/uploads"
# Info do estabelecimento exibida no cardápio público + confirmação de pedido.
NEXT_PUBLIC_STORE_NAME="Dela's Vibe"
NEXT_PUBLIC_STORE_ADDRESS="Endereço a configurar"
NEXT_PUBLIC_STORE_PHONE="(00) 00000-0000"
# Web Push notifications para admins (novos pedidos web).
# Gere uma unica vez por ambiente via: npx tsx scripts/generate-vapid-keys.ts
# VAPID_PRIVATE_KEY NUNCA deve ser logada ou exposta ao client.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@example.com"
# === WhatsApp (Evolution API) ===
# URL base da Evolution API (sem barra no final).
EVOLUTION_API_BASE_URL="https://evolution.example.com"
# API key global da Evolution API (usada para criar/deletar instancias).
EVOLUTION_API_GLOBAL_APIKEY="REPLACE_ME"
# Chave AES-256 (32 bytes em base64) para cifrar a apikey da instancia no banco.
# Gerar com: openssl rand -base64 32
# IMPORTANTE: NAO rotacionar sem antes desconectar a instancia (a apikey existente
# nao podera ser decifrada com a nova chave).
APP_ENCRYPTION_KEY="REPLACE_ME"
